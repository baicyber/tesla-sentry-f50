#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
# 看门狗协作: 手动 stop/disable 是有意停止, 不要自动拉起; start/restart 会清除 stop 标记
WATCHDOG_DIR=/root/tsf-watchdog
STOP_FLAG=/tmp/tsf-watchdog.stopped-tesla-live
DISABLE_FLAG=$WATCHDOG_DIR/disabled-tesla-live
start_service() {
    rm -f "$STOP_FLAG" /tmp/tsf-watchdog.pause
    set -a; [ -f /etc/tesla-sentry.conf ] && . /etc/tesla-sentry.conf; set +a
    if [ -n "${TSF_CARD_UUID:-}" ]; then
        . "$TSF_DIR/tsf-storage.sh" || return 1
        tsf_storage_ready || return 1
    fi
    procd_open_instance
    procd_set_param command "${TSF_PYTHON:-/usr/bin/python3}" "$TSF_DIR/tesla-live-sync.py"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
# 不要覆盖 stop(): rc.common 默认的 stop() 会先调 stop_service 再 procd_kill 杀进程。
# 只挂 stop_service 钩子写手动停止标记, 避免 restart 时旧进程残留。
stop_service() {
    : > "$STOP_FLAG"
}
disable() {
    mkdir -p "$WATCHDOG_DIR"
    : > "$STOP_FLAG"
    : > "$DISABLE_FLAG"
    rm -f /etc/rc.d/S99tesla-live /etc/rc.d/K99tesla-live
}
enable() {
    rm -f "$STOP_FLAG" "$DISABLE_FLAG"
    ln -sf ../init.d/tesla-live /etc/rc.d/S99tesla-live
}
