#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
# 看门狗协作: 手动 stop/disable 是有意停止, 不要自动拉起; start/restart 会清除 stop 标记
WATCHDOG_DIR=/root/tsf-watchdog
STOP_FLAG=/tmp/tsf-watchdog.stopped-tesla-viewer
DISABLE_FLAG=$WATCHDOG_DIR/disabled-tesla-viewer
start_service() {
    rm -f "$STOP_FLAG" /tmp/tsf-watchdog.pause
    # set -a 兼容会继承 shell 环境的 init; procd 不继承 export,
    # 程序启动时会自己读 conf 补齐, 因此自定义清理/同步参数在 F50 上也能生效。
    set -a; [ -f /etc/tesla-sentry.conf ] && . /etc/tesla-sentry.conf; set +a
    if [ -n "${TSF_CARD_UUID:-}" ]; then
        # 数据卡未就绪也要启动网页: 卡没插/没格式化/挂载失败时, 网页是唯一的排查与格式化入口,
        # 这里 return 1 会让用户连设置页都进不去, 只能 SSH 或拆机。
        if ! { . "$TSF_DIR/tsf-storage.sh" && tsf_storage_ready; }; then
            logger -t tesla-viewer "数据卡未就绪, 仍启动网页以便排查/格式化"
        fi
    fi
    procd_open_instance
    procd_set_param command "${TSF_PYTHON:-/usr/bin/python3}" "$TSF_DIR/sentry-viewer.py"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
# 不要覆盖 stop(): rc.common 默认的 stop() 会先调 stop_service 再 procd_kill 杀进程。
# 只挂 stop_service 钩子写手动停止标记, 否则旧进程没被杀死, 新进程抢不到 8080 端口导致网页打不开。
stop_service() {
    : > "$STOP_FLAG"
}
disable() {
    mkdir -p "$WATCHDOG_DIR"
    : > "$STOP_FLAG"
    : > "$DISABLE_FLAG"
    rm -f /etc/rc.d/S99tesla-viewer /etc/rc.d/K99tesla-viewer
}
enable() {
    rm -f "$STOP_FLAG" "$DISABLE_FLAG"
    ln -sf ../init.d/tesla-viewer /etc/rc.d/S99tesla-viewer
}
