#!/bin/sh /etc/rc.common
# Mount the F50 data card by filesystem UUID before starting the Tesla apps.
# The card is a normal MBR/ext4 filesystem; the virtual Tesla disk remains
# a separate exFAT image inside /mnt/sdcard/tesla-sentry.

START=08
STOP=99

set -a
[ -f /etc/tesla-sentry.conf ] && . /etc/tesla-sentry.conf
set +a
UUID=${TSF_CARD_UUID:-}
MNT=${TSF_CARD_MNT:-/mnt/sdcard}
# 挂载点防呆: 旧配置若指向系统目录, 覆盖挂载会让设备不可用
case "$MNT" in
    /|/mnt|/bin|/bin/*|/boot|/boot/*|/dev|/dev/*|/etc|/etc/*|/home|/home/*|\
    /lib|/lib/*|/lib64|/lib64/*|/opt|/opt/*|/overlay|/overlay/*|/proc|/proc/*|\
    /rom|/rom/*|/root|/root/*|/sbin|/sbin/*|/sys|/sys/*|/tmp|/tmp/*|\
    /usr|/usr/*|/var|/var/*|/www|/www/*)
        logger -t tsf-mount "挂载点 $MNT 不合法, 回退到 /mnt/sdcard"
        MNT=/mnt/sdcard
        ;;
esac
TSF_DIR=${TSF_DIR:-/opt/tesla-sentry}
. "$TSF_DIR/tsf-storage.sh" || exit 1

start_apps() {
    if [ -f /etc/mu300/usb-storage-boot ] && [ -x "$TSF_DIR/tesla-usb-start.sh" ]; then
        # 协调器失败(ADB 等不到 / 抢不到锁 / 角色是 host)只该影响 U 盘导出。这里不能 return,
        # 否则 tesla-live 和 tesla-viewer 一起被拦掉: 车里没有 U 盘, 也进不了网页, 只能 SSH。
        sh "$TSF_DIR/tesla-usb-start.sh" ||
            logger -t tsf-mount "USB 协调启动失败(见 tsf-usb 日志), 继续启动应用服务"
    elif [ -x "$TSF_DIR/tesla-gadget.sh" ]; then
        # 全新安装还没有镜像时导出必然失败; 不能因此拦掉网页, 否则无法进入首次设置
        sh "$TSF_DIR/tesla-gadget.sh" on ||
            logger -t tsf-mount "USB 导出失败(见 tesla-gadget.log), 继续启动应用服务"
    else
        /etc/init.d/tesla-gadget start ||
            logger -t tsf-mount "USB gadget 启动失败, 继续启动应用服务"
    fi
    /etc/init.d/tesla-live start ||
        logger -t tsf-mount "tesla-live 启动失败, 继续启动网页服务"
    /etc/init.d/tesla-viewer start
}

stop_apps() {
    /etc/init.d/tesla-live stop 2>/dev/null
    /etc/init.d/tesla-viewer stop 2>/dev/null
    if [ -x "$TSF_DIR/tesla-gadget.sh" ]; then
        sh "$TSF_DIR/tesla-gadget.sh" off >/dev/null 2>&1
    else
        /etc/init.d/tesla-gadget stop 2>/dev/null
    fi
}

mount_card() {
    [ -n "$UUID" ] || return 1
    tsf_storage_ready && return 0
    # An unrelated mounted disk must never be used as this installation's data disk.
    awk -v m="$MNT" '$2 == m {found=1} END {exit !found}' /proc/mounts && return 1
    mkdir -p "$MNT" || return 1
    DEV=$(blkid -U "$UUID" 2>/dev/null)
    [ -n "$DEV" ] && [ -b "$DEV" ] || return 1
    [ "$(blkid -o value -s TYPE "$DEV" 2>/dev/null)" = "ext4" ] || return 1
    mount -t ext4 -o noatime "$DEV" "$MNT" 2>/dev/null || return 1
    tsf_storage_ready || return 1
    logger -t tsf-mount "mounted $DEV -> $MNT"
    return 0
}

wait_and_start_services() {
    i=0
    while [ "$i" -lt 60 ]; do
        # 只等数据卡本身: gadget 目录 / UDC 缺失只影响车机 U 盘导出, 不该拦掉网页服务
        if mount_card; then
            logger -t tsf-mount "data card ready after ${i}s"
            start_apps
            return $?
        fi
        sleep 1
        i=$((i + 1))
    done
    # 卡挂不上也要把网页拉起来: 否则没有格式化/换卡/排查的入口, 只能 SSH
    logger -t tsf-mount "FAILED: card UUID $UUID not mountable after 60s; 仅启动网页以便排查"
    /etc/init.d/tesla-viewer start
    return 1
}

start() {
    [ -n "$UUID" ] || { logger -t tsf-mount "TSF_CARD_UUID is required"; return 1; }
    wait_and_start_services
}

stop() {
    stop_apps
    tsf_storage_ready || return 0
    i=0
    while grep -q " $MNT " /proc/mounts && [ "$i" -lt 10 ]; do
        umount "$MNT" 2>/dev/null
        sleep 1
        i=$((i + 1))
    done
    if grep -q " $MNT " /proc/mounts; then
        logger -t tsf-mount "FAILED to unmount $MNT"
        return 1
    fi
    logger -t tsf-mount "unmounted $MNT"
    return 0
}

boot() { (start) >/dev/null 2>&1 & }
shutdown() { stop; }
restart() { stop; start; }
