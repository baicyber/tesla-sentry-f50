TSF_DIR=/opt/tesla-sentry
# Generated by install-f50.sh from the mounted data card. Do not copy another card's UUID.
TSF_CARD_UUID=
TSF_CARD_MNT=/mnt/mmc
# 2.8.48+: 统一视频存储根目录; IMG/ARCHIVE/TRANSCODE 固定派生:
#   <VIDEO_ROOT>/img/teslacam.img          车机 U 盘镜像
#   <VIDEO_ROOT>/archive/                   归档区主目录
#   <VIDEO_ROOT>/archive/transcode_cache/   转码缓存
TSF_VIDEO_ROOT=/mnt/mmc/tesla-sentry
TSF_IMG=/mnt/mmc/tesla-sentry/img/teslacam.img
TSF_ARCHIVE=/mnt/mmc/tesla-sentry/archive
TSF_MNT=/tmp/teslamnt
TSF_LOOP=/dev/loop3
TSF_PORT=8080
TSF_IDLE=600
TSF_USB_TIMEOUT=300
TSF_LOSETUP=
TSF_GADGET=/sys/kernel/config/usb_gadget/linux
TSF_GADGET_CONFIG=c.1
TSF_UDC=
TSF_CACHE=/opt/tesla-sentry/cache
# 转码缓存放在归档区内 transcode_cache 子目录 (数据卡), 与归档视频一一对应
TSF_TRANSCODE_DIR=/mnt/mmc/tesla-sentry/archive/transcode_cache
TSF_LOG_DIR=/mnt/mmc/tesla-sentry/logs
TSF_LIVE_LOG=/mnt/mmc/tesla-sentry/logs/tesla-live.log
TSF_LIVE_STATE=/mnt/mmc/tesla-sentry/live-state.json
TSF_FFMPEG=/usr/bin/ffmpeg
TSF_FFPROBE=/usr/bin/ffprobe
TSF_USB_LOCK=/tmp/tsf-usb.lock
TSF_RECENT_ROLL_MIN=60
TSF_RECENT_KEEP_MIN=60
# 「最近1小时监控」体积上限(GiB), 0=不限; 6 路 1 小时约 12GiB
TSF_RECENT_MAX_GB=12
TSF_BOX_KEEP_DAYS=14
TSF_BOX_MAX_GB=12
TSF_DRIVE_MAX_GB=12
TSF_ARCHIVE_TOTAL_GB=34
TSF_DISK_GUARD_INTERVAL=60
TSF_FREE_MIN_MB=4096
TSF_FREE_TARGET_MB=10240
TSF_LIVE_INTERVAL=15
TSF_SYNC_FAIL_RETRY_SEC=300
TSF_SYNC_FAIL_RETRY_MAX_SEC=1800
